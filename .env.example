# Copy to project-root .env. Never commit or paste the actual key.
# Obtain a key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
#
# The review app requires explicit approved-data consent before sending text.
# Use synthetic or approved redacted documents only. Free-tier content may be
# used by Google to improve its products; live taxpayer uploads are not approved.
#
# Optional, temporary diagnostic: print Gemini's raw JSON response in the backend terminal.
# Contains document-derived data. Leave off normally; do not share logs without redacting.
# GEMINI_DEBUG=1

# Only the original main.py intake CLI supports Claude; the review app uses Gemini.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
